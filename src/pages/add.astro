---
import { getCollection } from "astro:content";
import SideNav from "../components/SideNav.astro";
import SongEditorWorkspace from "../components/SongEditorWorkspace.astro";
import AppLayout from "../layouts/AppLayout.astro";

const songs = await getCollection("songs");
---

<AppLayout title="添加歌曲候选 | Guitare Songbook" description="通过网页检索生成待审核的歌曲候选">
  <div class="app-shell">
    <SideNav songs={songs} currentPage="add" />
    <main class="add-main">
      <header class="mobile-topbar">
        <button class="icon-button" type="button" data-open-nav aria-label="打开歌曲目录">☰</button>
        <strong>添加歌曲</strong>
        <span aria-hidden="true"></span>
      </header>

      <div class="add-page">
        <header class="add-page__header">
          <p class="eyebrow">PHASE 2C · EDIT, PREVIEW, PUBLISH</p>
          <h1>生成歌曲候选</h1>
          <p>先生成结构化草稿并人工核对；确认后可安全提交到 GitHub，等待自动验证和部署。</p>
        </header>

        <section class="add-panel" aria-labelledby="search-title">
          <h2 id="search-title">查找歌曲</h2>
          <form data-generate-form>
            <label>
              <span>歌名 <strong aria-hidden="true">*</strong></span>
              <input name="title" required maxlength="100" autocomplete="off" />
            </label>
            <label>
              <span>歌手 <small>可选</small></span>
              <input name="artist" maxlength="100" autocomplete="off" />
            </label>
            <button class="primary-button" type="submit" data-generate-button>
              查找并生成
            </button>
          </form>
          <p class="add-status" data-generate-status role="status" aria-live="polite"></p>
        </section>

        <section class="candidate-panel" data-candidate hidden aria-labelledby="candidate-title">
          <div class="candidate-heading">
            <div>
              <p class="eyebrow">CANDIDATE</p>
              <h2 id="candidate-title" data-candidate-title></h2>
              <p data-candidate-artist></p>
            </div>
            <span data-candidate-confidence></span>
          </div>

          <dl class="candidate-meta">
            <div><dt>原调</dt><dd data-candidate-key></dd></div>
            <div><dt>级数基准</dt><dd data-candidate-degree-key></dd></div>
            <div><dt>Capo</dt><dd data-candidate-capo></dd></div>
            <div><dt>版本</dt><dd data-candidate-version></dd></div>
          </dl>

          <div class="candidate-columns">
            <section>
              <h3>来源</h3>
              <ul data-candidate-sources></ul>
            </section>
            <section>
              <h3>需要留意</h3>
              <ul data-candidate-warnings></ul>
            </section>
            <section>
              <h3>不确定字段</h3>
              <ul data-candidate-uncertain></ul>
            </section>
          </div>

          <SongEditorWorkspace />

          <details class="candidate-json">
            <summary>查看候选 JSON</summary>
            <pre data-candidate-json></pre>
          </details>

          <div class="duplicate-notice" data-duplicate hidden>
            <strong>歌曲已存在</strong>
            <a data-duplicate-link href="/">打开现有歌曲</a>
          </div>

          <label class="publish-confirmation">
            <input type="checkbox" data-publish-confirm disabled />
            <span>我已核对歌曲版本、调性、Capo、歌词、和弦、来源和不确定字段。</span>
          </label>

          <p class="publish-config" data-publish-config>正在检查 GitHub 写入配置…</p>
          <button class="primary-button" type="button" data-publish-button disabled>
            加入曲库
          </button>
          <div class="publish-result" data-publish-result hidden aria-live="polite">
            <strong>歌曲已提交，正在等待自动部署。</strong>
            <p>预计稍后出现在曲库。</p>
            <a data-publish-commit target="_blank" rel="noreferrer noopener">查看 GitHub commit</a>
          </div>
        </section>
      </div>
    </main>
  </div>
  <script src="../scripts/app-shell.ts"></script>
  <script src="../scripts/add-song.ts"></script>
</AppLayout>
