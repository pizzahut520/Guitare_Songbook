---
import type { Song } from "../lib/song-schema";
import { buildSongRenderBlocks, gridTemplate, lyricRows } from "../lib/song-render-model";

interface Props {
  song: Song;
}

const { song } = Astro.props;
const renderBlocks = buildSongRenderBlocks(song);
---

<article
  class="song-sheet"
  data-song-sheet
  data-degree-key={song.degree_key}
  data-song-title={song.title}
  data-pagefind-body
>
  <header class="song-header">
    <div class="song-header__title">
      <p>GUITARE SONGBOOK</p>
      <h1 data-pagefind-meta="title">{song.title}</h1>
      <span>{song.artist}</span>
    </div>
    <dl class="song-header__key" aria-label="演奏信息">
      <div><dt>原调</dt><dd>{song.original_key}</dd></div>
      <div><dt>级数基准</dt><dd data-active-key>{song.degree_key}</dd></div>
      <div><dt>Capo</dt><dd>{song.capo}</dd></div>
    </dl>
    <div class="song-header__credits">
      <span>词：{song.credits.lyrics}</span>
      <span>曲：{song.credits.music}</span>
    </div>
  </header>

  <div class="song-body">
    {
      renderBlocks.map(({ block, renderId, repeated, repeat, sectionLabel }) => {
        if (block.type === "instrument") {
          return (
            <section class:list={["sheet-section", "instrument-block", { "is-repeated": repeated }]} data-block-id={renderId}>
              <header class="sheet-section__heading">
                <h2>{sectionLabel}</h2>
                {repeat && repeat.index === 1 && <span class="repeat-cue">↻ {repeat.label} ×{repeat.times}</span>}
              </header>
              <div class="instrument-line">
                <span class="instrument-progression" data-degree={block.progression}>
                  {block.progression}
                </span>
                {block.repeat && <strong class="repeat-mark">{block.repeat}</strong>}
              </div>
            </section>
          );
        }

        if (block.type === "lyric") {
          const rows = lyricRows(block);
          const labels = block.variant_labels ?? [];
          const grid = gridTemplate(block.widths, block.chords.length);
          return (
            <section
              class:list={["sheet-section", "lyric-block", `spacing-${block.spacing}`, `section-role-${block.section_role ?? "other"}`, { "is-repeated": repeated }]}
              data-block-id={renderId}
              style={`--phrase-grid: ${grid}`}
            >
              {(sectionLabel || (repeat && repeat.index === 1)) && (
                <header class="sheet-section__heading">
                  {sectionLabel && <h2>{sectionLabel}</h2>}
                  {repeat && repeat.index === 1 && <span class="repeat-cue">↻ {repeat.label} ×{repeat.times}</span>}
                </header>
              )}
              <div class="desktop-lyric">
                <div class="chord-row phrase-grid" aria-label="和弦">
                  {block.chords.map((chord) => (
                    <span data-degree={chord}>{chord}</span>
                  ))}
                </div>
                {rows.map((row, rowIndex) => (
                  <div class="lyric-line">
                    {labels[rowIndex] && (
                      <span class="variant-label">{labels[rowIndex]}</span>
                    )}
                    <div class="lyric-row phrase-grid">
                      {row.map((phrase) => <span>{phrase || "\u00a0"}</span>)}
                    </div>
                  </div>
                ))}
              </div>

              <div class="mobile-lyric">
                <div class="mobile-phrase-grid">
                  {block.chords.map((chord, phraseIndex) => (
                    <div class="mobile-phrase">
                      <span class="mobile-phrase__chord" data-degree={chord}>{chord}</span>
                      {rows.map((row, rowIndex) => (
                        <div class="mobile-phrase__variant">
                          {labels[rowIndex] && (
                            <span class="mobile-variant__label">{labels[rowIndex]}</span>
                          )}
                          <span class="mobile-phrase__lyric">
                            {row[phraseIndex] || "\u00a0"}
                          </span>
                        </div>
                      ))}
                    </div>
                  ))}
                </div>
              </div>
            </section>
          );
        }

        return (
          <details class="theory-legend" data-block-id={renderId}>
            <summary>{block.title}</summary>
            <div class="theory-legend__content">
              <div class="legend-grid">
                {block.items.map((item) => (
                  <p><strong>{item.quality}</strong> = {item.formula}</p>
                ))}
              </div>
              {block.note && <p class="legend-note">{block.note}</p>}
            </div>
          </details>
        );
      })
    }
  </div>
  {(song.source.reference || song.tags.length > 0) && (
    <footer class="song-sheet__footer">
      {song.source.reference && <p><strong>来源</strong> {song.source.reference}</p>}
      {song.tags.length > 0 && <p><strong>标签</strong> {song.tags.join(" · ")}</p>}
    </footer>
  )}
</article>
